# Enhanced: Create incremental manifest content
# $1: commit_id, $2: file_hash, $3: file_size
create_incremental_manifest_entry()
{
	local commit_id= file_hash= file_size= timestamp=
	commit_id="$1"
	file_hash="$2"
	file_size="$3"
	timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
	
	echo "version: $Incremental_version"
	echo "timestamp: $timestamp"
	echo "commit_id: $commit_id"
	echo "file_hash: $file_hash"
	echo "file_size: $file_size"
	echo "branch: $Incremental_branch"
}

# Enhanced: Calculate commit range for incremental push
# Returns: commit range in $r_commit_range
calculate_incremental_range()
{
	local remote_commit= local_commit= commit_range=
	
	# Get remote latest commit from manifest
	remote_commit=$(get_remote_latest_commit)
	
	# Get local latest commit
	local_commit=$(git rev-parse HEAD)
	
	if [ -n "$remote_commit" ] && [ "$remote_commit" != "$local_commit" ]; then
		# Calculate range: remote_commit..local_commit
		commit_range="${remote_commit}..${local_commit}"
		echo_info "Incremental range: $commit_range"
	else
		# Full push needed
		commit_range=""
		echo_info "Full push required"
	fi
	
	setvar "@r_commit_range" "$commit_range"
}

# Enhanced: Get remote latest commit from cached manifest
get_remote_latest_commit()
{
	local manifest_content= commit_line=
	
	if [ -f "$Local_manifest_cache" ]; then
		manifest_content=$(cat "$Local_manifest_cache")
		commit_line=$(echo "$manifest_content" | grep "^commit_id:" | head -1)
		echo "${commit_line#commit_id: }"
	fi
}

# Enhanced: Cache manifest locally for performance
cache_manifest_locally()
{
	local manifest_file= cache_dir=
	manifest_file="$1"
	
	cache_dir="$Localdir/cache"
	mkdir -p "$cache_dir"
	Local_manifest_cache="$cache_dir/latest_manifest"
	
	if [ -f "$manifest_file" ]; then
		cp "$manifest_file" "$Local_manifest_cache"
		echo_info "Manifest cached locally"
	fi
}

# compat/utility functions (keeping original functions)
# xfeed: The most basic output function puts $1 into the stdin of $2..$#
xfeed()
{
	local input_=
	input_=$1; shift
	"$@" <<EOF
$input_
EOF
}
xecho() { xfeed "$*" cat; }
xecho_n() { xecho "$@" | tr -d \\n ; } # kill newlines
echo_git() { xecho "$@" ; }  # Code clarity
echo_info() { xecho "gcrypt:" "$@" >&2; }
echo_die() { echo_info "$@" ; exit 1; }

isnull() { case "$1" in "") return 0;; *) return 1;; esac; }
isnonnull() { ! isnull "$1"; }
iseq() { case "$1" in "$2") return 0;; *) return 1;; esac; }
isnoteq() { ! iseq "$1" "$2"; }
negate() { ! "$@"; }

# Execute $@ or die
pipefail()
{
	"$@" || { echo_info "'$1' failed!"; kill $; exit 1; }
}

isurl() { isnull "${2%%$1://*}"; }
islocalrepo() { isnull "${1##/*}" && [ ! -e "$1/HEAD" ]; }

xgrep() { command grep "$@" || : ; }

# setvar is used for named return variables
# $1 *must* be a valid variable name, $2 is any value
setvar()
{
	isnull "${1##@*}" || echo_die "Missing @ for return variable: $1"
	eval ${1#@}=\$2
}

Newline="
"

# $1 is return var, $2 is value appended with newline separator
append_to()
{
	local f_append_tmp_=
	eval f_append_tmp_=\${1#@}
	isnull "$f_append_tmp_" || f_append_tmp_=$f_append_tmp_$Newline
	setvar "$1" "$f_append_tmp_$2"
}

# Enhanced: GPG hash function
gpg_hash()
{
	local hash_type="$1"
	case "$hash_type" in
		SHA256) shasum -a 256 | cut -d' ' -f1 ;;
		SHA224) shasum -a 224 | cut -d' ' -f1 ;;
		*) echo_die "Unsupported hash type: $hash_type" ;;
	esac
}
# Enhanced: Main incremental push function
do_incremental_push()
{
	local r_commit_range= commit_count= pack_objects= tmp_pack= tmp_encrypted=
	local new_serial= new_filename= manifest_content= tmp_manifest=
	
	echo_info "Starting incremental push for branch: $Incremental_branch"
	
	# Step 1: Calculate commit range
	calculate_incremental_range @r_commit_range
	
	if [ -z "$r_commit_range" ]; then
		echo_info "No incremental range found, falling back to full push"
		return 1  # Fall back to original push method
	fi
	
	# Step 2: Count commits in range
	commit_count=$(git rev-list --count "$r_commit_range" 2>/dev/null || echo "0")
	
	if [ "$commit_count" = "0" ]; then
		echo_info "No new commits to push"
		return 0
	fi
	
	echo_info "Found $commit_count new commits to push"
	
	# Step 3: Create incremental pack
	tmp_pack="$Tempdir/pack_incremental"
	tmp_encrypted="$Tempdir/pack_encrypted"
	
	# Get objects for the commit range
	git rev-list --objects "$r_commit_range" > "$tmp_pack.objects"
	
	# Create pack file for these objects
	git pack-objects --stdout < "$tmp_pack.objects" > "$tmp_pack" || {
		echo_die "Failed to create incremental pack"
	}
	
	# Step 4: Encrypt the pack
	local pack_key=
	pack_key=$(gen_key "$Packkey_bytes")
	
	ENCRYPT "$pack_key" < "$tmp_pack" > "$tmp_encrypted" || {
		echo_die "Failed to encrypt incremental pack"
	}
	
	# Step 5: Generate new filename
	new_serial=$((Remote_manifest_serial + 1))
	new_filename=$(generate_incremental_filename "$new_serial" "$(cat "$tmp_encrypted")")
	
	echo_info "Uploading incremental pack: $new_filename"
	
	# Step 6: Upload encrypted pack
	PUT "$URL" "$new_filename" "$tmp_encrypted" || {
		echo_die "Failed to upload incremental pack"
	}
	
	# Step 7: Create and upload new manifest
	local latest_commit=
	latest_commit=$(git rev-parse HEAD)
	
	tmp_manifest="$Tempdir/manifest_incremental"
	create_incremental_manifest_entry "$latest_commit" "$(cat "$tmp_encrypted" | gpg_hash SHA256)" "$(wc -c < "$tmp_encrypted")" > "$tmp_manifest"
	
	# Encrypt manifest
	local manifest_encrypted="$Tempdir/manifest_encrypted"
	PRIVENCRYPT "$Recipients" < "$tmp_manifest" > "$manifest_encrypted"
	
	# Generate manifest filename
	local manifest_filename=
	manifest_filename=$(generate_incremental_filename "$new_serial" "$(cat "$manifest_encrypted")")
	
	echo_info "Uploading new manifest: $manifest_filename"
	
	# Upload manifest
	PUT "$URL" "$manifest_filename" "$manifest_encrypted" || {
		echo_die "Failed to upload new manifest"
	}
	
	# Step 8: Update local cache
	cache_manifest_locally "$tmp_manifest"
	Remote_manifest_serial="$new_serial"
	
	# Cleanup
	rm -f "$tmp_pack" "$tmp_pack.objects" "$tmp_encrypted" "$tmp_manifest" "$manifest_encrypted"
	
	echo_info "Incremental push completed successfully"
	return 0
}

