}

# Enhanced: Calculate commit range for incremental push
# Returns: commit range in $r_commit_range
calculate_incremental_range()
{
	local remote_commit= local_commit= commit_range=
	
	# Check if remote repository exists
	if [ "$Did_find_repo" = "no" ]; then
		# No remote repository yet - this will be handled as initial push
		commit_range=""
		echo_info "No remote repository found - initial push required"
		setvar "@r_commit_range" "$commit_range"
		return 0
	fi
	
	# Get remote latest commit from manifest
	remote_commit=$(get_remote_latest_commit)
	
	# Get local latest commit
	local_commit=$(git rev-parse HEAD)
	
	if [ -n "$remote_commit" ] && [ "$remote_commit" != "$local_commit" ]; then
		# Calculate range: remote_commit..local_commit
		commit_range="${remote_commit}..${local_commit}"
		echo_info "Incremental range: $commit_range"
	else
		# Full push needed (or up to date)
		commit_range=""
		if [ -n "$remote_commit" ] && [ "$remote_commit" = "$local_commit" ]; then
			echo_info "Already up to date"
		else
			echo_info "Full push required"
		fi
	fi
	
	setvar "@r_commit_range" "$commit_range"
}

# Enhanced: Get remote latest commit from cached manifest
get_remote_latest_commit()
{
	local manifest_content= commit_line=
	
	if [ -f "$Local_manifest_cache" ]; then
		manifest_content=$(cat "$Local_manifest_cache")
		commit_line=$(echo "$manifest_content" | grep "^commit_id:" | head -1)
		echo "${commit_line#commit_id: }"
	fi
}

# Enhanced: Cache manifest locally for performance
cache_manifest_locally()
{
	local manifest_file= cache_dir=
	manifest_file="$1"
	
	cache_dir="$Localdir/cache"
	mkdir -p "$cache_dir"
	Local_manifest_cache="$cache_dir/latest_manifest"
	
	if [ -f "$manifest_file" ]; then
		cp "$manifest_file" "$Local_manifest_cache"
		echo_info "Manifest cached locally"
	fi
}

# compat/utility functions (keeping original functions)
# xfeed: The most basic output function puts $1 into the stdin of $2..$#
xfeed()
{
	local input_=
	input_=$1; shift
	"$@" <<EOF
$input_
EOF
}
xecho() { xfeed "$*" cat; }
xecho_n() { xecho "$@" | tr -d \\n ; } # kill newlines
echo_git() { xecho "$@" ; }  # Code clarity
echo_info() { xecho "gcrypt:" "$@" >&2; }
echo_die() { echo_info "$@" ; exit 1; }

isnull() { case "$1" in "") return 0;; *) return 1;; esac; }
isnonnull() { ! isnull "$1"; }
iseq() { case "$1" in "$2") return 0;; *) return 1;; esac; }
isnoteq() { ! iseq "$1" "$2"; }
negate() { ! "$@"; }

# Execute $@ or die
