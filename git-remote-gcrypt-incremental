# Convert URI in standard or nonstandard form to rsync's user@host:path
rsynclocation()
{
	echo "${1#rsync://}" | sed 's/\(^[^:/]*\)\//\1:\//'
}

# setvar is used for named return variables
# $1 *must* be a valid variable name, $2 is any value
setvar()
{
	isnull "${1##@*}" || echo_die "Missing @ for return variable: $1"
	eval ${1#@}=\$2
}

Newline="
"

# $1 is return var, $2 is value appended with newline separator
append_to()
{
	local f_append_tmp_=
	eval f_append_tmp_=\${1#@}
	isnull "$f_append_tmp_" || f_append_tmp_=$f_append_tmp_$Newline
	setvar "$1" "$f_append_tmp_$2"
}

# Pick words from each line
# $1 return variable name
# $2 input value
pick_fields_1_2()
{
	local f_ret= f_one= f_two=
	while read f_one f_two _ # from << here-document
	do
		f_ret="$f_ret$f_one $f_two$Newline"
	done <<EOF
$2
EOF
	setvar "$1" "${f_ret#$Newline}"
}

# Take all lines matching $2 (full line)
# $1 return variable name
# $2 filter word
# $3 input value
#  if $1 is a literal `!', the match is reversed (and arguments shift)
#  we instead remove all lines matching
filter_to()
{
	local f_neg= f_line= f_ret= IFS=
	isnoteq "$1" "!" || { f_neg=negate; shift; }
	IFS=$Newline
	for f_line in $3
	do
		$f_neg isnonnull "${f_line##$2}" || f_ret=$f_ret$f_line$Newline
	done
	setvar "$1" "${f_ret%$Newline}"
}

# Enhanced: GPG hash function
gpg_hash()
{
	local hash_type="$1"
	case "$hash_type" in
		SHA256) shasum -a 256 | cut -d' ' -f1 ;;
		SHA224) shasum -a 224 | cut -d' ' -f1 ;;
		*) echo_die "Unsupported hash type: $hash_type" ;;
	esac
}
# Enhanced: Main incremental push function
do_incremental_push()
{
	local r_commit_range= commit_count= pack_objects= tmp_pack= tmp_encrypted=
	local new_serial= new_filename= manifest_content= tmp_manifest=
	local is_initial_push=no r_sigmatch= r_signers=
	
	echo_info "Starting incremental push for branch: $Incremental_branch"
	
	# Read configuration for encryption
	read_config @r_sigmatch @r_signers
	
	# Step 1: Check if this is the first push (remote repository doesn't exist)
	if [ "$Did_find_repo" = "no" ]; then
		echo_info "Initial incremental push - remote repository will be created"
		is_initial_push=yes
		r_commit_range=""  # Will push all commits for initial push
	else
		# Step 2: Calculate commit range for existing repository
		calculate_incremental_range @r_commit_range
		
		if [ -z "$r_commit_range" ]; then
			echo_info "Full push required"
			is_initial_push=yes  # Treat as initial push
		fi
	fi
	
	# Step 3: Count commits in range
	if [ "$is_initial_push" = "yes" ]; then
		# For initial push, count all commits in the branch
		commit_count=$(git rev-list --count HEAD 2>/dev/null || echo "0")
		echo_info "Initial push: Found $commit_count commits to push"
	else
		commit_count=$(git rev-list --count "$r_commit_range" 2>/dev/null || echo "0")
		
		if [ "$commit_count" = "0" ]; then
			echo_info "No new commits to push"
			return 0
		fi
		
		echo_info "Found $commit_count new commits to push"
	fi
	
	# Step 4: Create incremental pack
	tmp_pack="$Tempdir/pack_incremental"
	tmp_encrypted="$Tempdir/pack_encrypted"
	
	# Get objects for the commit range
	if [ "$is_initial_push" = "yes" ]; then
		# For initial push, get all objects
		git rev-list --objects HEAD > "$tmp_pack.objects"
	else
		git rev-list --objects "$r_commit_range" > "$tmp_pack.objects"
	fi
	
	# Create pack file for these objects
	git pack-objects --stdout < "$tmp_pack.objects" > "$tmp_pack" || {
		echo_die "Failed to create incremental pack"
	}
	
	# Step 5: Encrypt the pack
	local pack_key=
	pack_key=$(genkey "$Packkey_bytes")
	
	ENCRYPT "$pack_key" < "$tmp_pack" > "$tmp_encrypted" || {
		echo_die "Failed to encrypt incremental pack"
	}
	
	# Step 6: Initialize remote repository if needed
	if [ "$Did_find_repo" = "no" ]; then
		echo_info "Creating remote repository for incremental mode"
		make_new_repo
	fi
	
	# Step 7: Generate new filename
	new_serial=$((Remote_manifest_serial + 1))
	new_filename=$(generate_incremental_filename "$new_serial" "$(cat "$tmp_encrypted")")
	
	echo_info "Uploading incremental pack: $new_filename"
	
	# Step 8: Upload encrypted pack
	PUT "$URL" "$new_filename" "$tmp_encrypted" || {
		echo_die "Failed to upload incremental pack"
	}
	
	# Step 9: Create and upload new manifest
	local latest_commit=
	latest_commit=$(git rev-parse HEAD)
	
	tmp_manifest="$Tempdir/manifest_incremental"
	create_incremental_manifest_entry "$latest_commit" "$(cat "$tmp_encrypted" | gpg_hash SHA256)" "$(wc -c < "$tmp_encrypted")" > "$tmp_manifest"
	
	# Encrypt manifest
	local manifest_encrypted="$Tempdir/manifest_encrypted"
	PRIVENCRYPT "$Recipients" < "$tmp_manifest" > "$manifest_encrypted"
	
	# Generate manifest filename
	local manifest_filename=
	manifest_filename=$(generate_incremental_filename "$new_serial" "$(cat "$manifest_encrypted")")
	
	echo_info "Uploading new manifest: $manifest_filename"
	
	# Upload manifest
	PUT "$URL" "$manifest_filename" "$manifest_encrypted" || {
		echo_die "Failed to upload new manifest"
	}
	
	# Step 10: Update local cache and remote serial
	cache_manifest_locally "$tmp_manifest"
	Remote_manifest_serial="$new_serial"
	
	# Step 11: Update repository status
	Did_find_repo=yes
	
	# Cleanup
	rm -f "$tmp_pack" "$tmp_pack.objects" "$tmp_encrypted" "$tmp_manifest" "$manifest_encrypted"
	
	echo_info "Incremental push completed successfully"
	return 0
}

