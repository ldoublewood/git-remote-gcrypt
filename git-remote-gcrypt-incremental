# Enhanced: Encryption functions (simplified versions)
ENCRYPT()
{
	local key="$1"
	# Simplified encryption - in real implementation would use GPG
	gpg --cipher-algo AES256 --compress-algo 1 --symmetric --passphrase "$key" --batch --quiet
}

PRIVENCRYPT()
{
	local recipients="$1"
	# Encrypt and sign for recipients
	gpg --trust-model always --encrypt --sign --armor --batch --quiet $(for r in $recipients; do echo "--recipient $r"; done)
}

PRIVDECRYPT()
{
	local sigmatch="$1"
	local signers="$2"
	# Decrypt and verify
	gpg --decrypt --batch --quiet
}

# Enhanced: Key generation
gen_key()
{
	local bytes="$1"
	# Generate random key
	dd if=/dev/urandom bs="$bytes" count=1 2>/dev/null | base64 | tr -d '\n='
}
# Enhanced: Main entry point with incremental support
main()
{
	local cmd="$1"
	local remote_name="$2"
	local url="$3"
	
	# Set global variables
	REMOTE_NAME="$remote_name"
	URL="$url"
	
	# Initialize temp directory
	Tempdir=$(mktemp -d)
	trap 'rm -rf "$Tempdir"' EXIT
	
	# Initialize local directory
	mkdir -p "$Localdir"
	
	case "$cmd" in
		capabilities)
			echo "push"
			echo "fetch"
			echo ""
			;;
		list)
			# Enhanced: Check for incremental mode during list
			if is_incremental_enabled; then
				echo_info "Incremental mode detected"
				get_latest_manifest_serial
			fi
			do_list
			;;
		push)
			# Enhanced: Try incremental push first
			if is_incremental_enabled; then
				if do_incremental_push; then
					echo_info "Incremental push successful"
					exit 0
				else
					echo_info "Falling back to full push"
				fi
			fi
			do_push
			;;
		fetch)
			# Enhanced: Try incremental pull first
			if is_incremental_enabled; then
				if do_incremental_pull; then
					echo_info "Incremental pull successful"
					exit 0
				else
					echo_info "Falling back to full fetch"
				fi
			fi
			do_fetch
			;;
		*)
			echo_die "Unknown command: $cmd"
			;;
	esac
}

# Enhanced: Configuration validation
validate_incremental_config()
{
	local incremental_branch=
	incremental_branch=$(git config --get "remote.$REMOTE_NAME.gcrypt-incremental-branch" 2>/dev/null || echo "")
	
	if [ -n "$incremental_branch" ]; then
		echo_info "Incremental branch configured: $incremental_branch"
		
		# Validate branch exists
		if ! git show-ref --verify --quiet "refs/heads/$incremental_branch"; then
			echo_info "Warning: Incremental branch '$incremental_branch' does not exist"
		fi
		
		return 0
	fi
	
	return 1
}

