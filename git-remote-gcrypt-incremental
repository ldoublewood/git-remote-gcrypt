# Enhanced: List remote references
do_list()
{
	local obj_id= ref_name= line_=
	
	if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
		echo_info "Listing remote references..."
	fi
	
	# For incremental mode, we need to handle the initial case
	# where the remote repository might not exist yet
	
	# Try to connect to remote (simplified version)
	if ! ensure_connected_simple; then
		# Repository doesn't exist yet - return empty list
		if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
			echo_info "Remote repository not found, returning empty list"
		fi
		echo_git
		return 0
	fi
	
	# If we have a refs list, output it
	if [ -n "$Refslist" ]; then
		xecho "$Refslist" | while read line_
		do
			isnonnull "$line_" || break
			obj_id=${line_%% *}
			ref_name=${line_##* }
			echo_git "$obj_id" "$ref_name"
			if iseq "$ref_name" "refs/heads/master"
			then
				echo_git "@refs/heads/master HEAD"
			fi
		done
	else
		if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
			echo_info "No remote references found"
		fi
	fi
	
	# End with blank line (required by Git protocol)
	echo_git
}

# Enhanced: Simplified connection check
ensure_connected_simple()
{
	if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
		echo_info "Checking remote connection to: $URL"
	fi
	
	# Check if we already tried to connect
	if isnonnull "$Did_find_repo"; then
		return $([ "$Did_find_repo" = "yes" ])
	fi
	
	# For initial implementation, we'll assume the repository doesn't exist
	# This allows Git to proceed with the first push
	Did_find_repo=no
	
	# Initialize empty refs list
	Refslist=""
	
	if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
		echo_info "Remote repository status: $Did_find_repo"
	fi
	
	return 1  # Repository not found (initial state)
}

# Enhanced: Create new repository
make_new_repo()
{
	echo_info "Setting up new repository"
	
	# Create the remote directory structure first
	PUTREPO "$URL"
	
	# Generate a new repository ID
	Repoid=$(rungpg --armor --gen-rand 1 15 | tr -d '\n')
	
	# Initialize empty lists
	Refslist=""
	Packlist=""
	Keeplist=""
	Extnlist=""
	
	# Mark as found
	Did_find_repo=yes
	
	echo_info "Remote ID is :id:$Repoid"
}

# Enhanced: Safe git rev-parse
safe_git_rev_parse()
{
	git cat-file --batch-check 2>/dev/null |
	while read sha1_ type_ size_
	do
		case $type_ in
		commit|tree|blob|tag)
			echo "$sha1_"
			;;
		missing)
			# Ignore
			;;
		*)
			echo_info "WARNING: Ignoring invalid object $sha1_"
			;;
		esac
	done
}

# Enhanced: File transfer functions
# Fetch repo $1, file $2, tmpfile in $3
GET()
{
	if isurl sftp "$1"
	then
		(exec 0>&-; curl -s -S -k "$1/$2") > "$3"
	elif isurl rsync "$1"
	then
		(exec 0>&-; rsync -I -W "$(rsynclocation "$1")"/"$2" "$3" >&2)
	elif isurl rclone "$1"
	then
		(exec 0>&-; rclone copyto --error-on-no-transfer "${1#rclone://}"/"$2" "$3" >&2)
	elif islocalrepo "$1"
	then
		cat "$1/$2" > "$3" 2>/dev/null
	else
		gitception_get "${1#gitception://}" "$2" > "$3"
	fi
}

# Put repo $1, file $2 or fail, tmpfile in $3
PUT()
{
	if isurl sftp "$1"
	then
		curl -s -S -k --ftp-create-dirs -T "$3" "$1/$2"
	elif isurl rsync "$1"
	then
		# Ensure the remote directory exists and use proper rsync options
		local rsync_dest="$(rsynclocation "$1")"
		if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
			echo_info "Uploading to rsync destination: $rsync_dest/$2"
		fi
		
		# For older rsync versions, we need to ensure the directory exists first
		# Extract directory path from the destination
		local dest_dir=$(dirname "$rsync_dest/$2")
		if [ "$dest_dir" != "." ] && [ "$dest_dir" != "$rsync_dest" ]; then
			# Try to create the directory structure via SSH
			local ssh_host="${rsync_dest%%:*}"
			local remote_path="${rsync_dest#*:}"
			local file_dir="$remote_path/$(dirname "$2")"
			
			if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
				echo_info "Creating remote directory: $ssh_host:$file_dir"
			fi
			
			# Create directory via SSH (ignore errors if it already exists)
			ssh "$ssh_host" "mkdir -p '$file_dir'" 2>/dev/null || :
		fi
		
		# Now upload the file
		rsync $Conf_rsync_put_flags -I -W "$3" "$rsync_dest/$2" >&2
	elif isurl rclone "$1"
	then
		rclone copyto --error-on-no-transfer "$3" "${1#rclone://}"/"$2" >&2
	elif islocalrepo "$1" || [ "${1#file://}" != "$1" ]
	then
		local target_dir="${1#file://}"
		mkdir -p "$target_dir" 2>/dev/null || :
		mkdir -p "$(dirname "$target_dir/$2")" 2>/dev/null || :
		cat >| "$target_dir/$2" < "$3"
	else
		echo_die "Unsupported URL scheme: $1"
	fi
}

# Put directory for repo $1
PUTREPO()
{
	if isurl sftp "$1"
	then
		:
	elif isurl rsync "$1"
	then
		# Create the remote directory structure
		local rsync_dest="$(rsynclocation "$1")"
		if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
			echo_info "Creating remote directory: $rsync_dest"
		fi
		# Create directory by syncing an empty local directory
		mkdir -p "$Localdir/empty" 2>/dev/null || :
		# Create the remote directory via SSH for older rsync versions
		local ssh_host="${rsync_dest%%:*}"
		local remote_path="${rsync_dest#*:}"
		
		if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
			echo_info "Creating remote directory via SSH: $ssh_host:$remote_path"
		fi
		
		# Create directory via SSH
		ssh "$ssh_host" "mkdir -p '$remote_path'" >&2
	elif isurl rclone "$1"
	then
		rclone mkdir "${1#rclone://}" >&2
	elif islocalrepo "$1" || [ "${1#file://}" != "$1" ]
	then
		local target_dir="${1#file://}"
		mkdir -p "$target_dir"
	else
		echo_info "Warning: Unsupported URL scheme for PUTREPO: $1"
	fi
}

do_push()
{
	local r_args="$1"
	local r_revlist= pack_id= key_= obj_= src_= dst_= \
		r_pack_delete= tmp_encrypted= tmp_objlist= tmp_manifest= \
		force_passed= r_sigmatch= r_signers=
	
	echo_info "Performing encrypted push"
	if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
		echo_info "Push arguments: $r_args"
	fi
	
	# Read configuration
	read_config @r_sigmatch @r_signers
	
	# Ensure we're connected to the remote
	ensure_connected_simple
	
	if iseq "$Did_find_repo" "no"
	then
		make_new_repo
	fi

	if isnonnull "$Refslist"
	then
		# mark all remote refs with  ^<sha-1> (if sha-1 exists locally)
		r_revlist=$(echo "$Refslist" | cut -f 1 -d ' ' |
			safe_git_rev_parse | sed -e 's/^\(.\)/^&/')
	fi

	# Parse refspecs
	while IFS=: read -r src_ dst_ # << +src:dst
	do
		if [ $(echo "$src_" | cut -c1) != + ]
		then
			force_passed=false
		fi

		src_=${src_#+}
		filter_to ! @Refslist "$Hex40 $dst_" "$Refslist"

		if isnonnull "$src_"
		then
			if [ -z "$r_revlist" ]; then
				r_revlist="$src_"
			else
				r_revlist="$r_revlist$Newline$src_"
			fi
			obj_=$(echo "$src_" | safe_git_rev_parse)
			if [ -z "$Refslist" ]; then
				Refslist="$obj_ $dst_"
			else
				Refslist="$Refslist$Newline$obj_ $dst_"
			fi
		fi
	done <<EOF
$r_args
EOF

	if [ "$force_passed" = false ]
	then
		if [ "$Conf_force_required" = true ]
		then
			echo_die "Implicit force push disallowed by gcrypt configuration."
		else
			echo_info "Due to a longstanding bug, this push implicitly has --force."
			echo_info "Consider explicitly passing --force, and setting"
			echo_info "gcrypt's require-explicit-force-push git config key."
		fi
	fi

	tmp_encrypted="$Tempdir/packP"
	tmp_objlist="$Tempdir/objlP"

	if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
		echo_info "r_revlist content: '$r_revlist'"
	fi
	
	{
		if [ -n "$r_revlist" ]; then
			echo "$r_revlist" | git rev-list --objects --stdin --
		else
			# If no revlist, get all objects for the refs we're pushing
			git rev-list --objects --all
		fi
	} > "$tmp_objlist"

	# Only send pack if we have any objects to send
	if [ -s "$tmp_objlist" ]
	then
		echo_info "Encrypting objects"
		key_=$(genkey "$Packkey_bytes")
		pack_id=$(export GIT_ALTERNATE_OBJECT_DIRECTORIES=$Tempdir;
			pipefail git pack-objects --stdout < "$tmp_objlist" |
			pipefail ENCRYPT "$key_" |
			tee "$tmp_encrypted" | gpg_hash "$Hashtype")

		append_to @Packlist "pack :${Hashtype}:$pack_id $key_"
	fi

	# Generate manifest
	echo_info "Encrypting to: $Recipients"
	echo_info "Requesting manifest signature"

	tmp_manifest="$Tempdir/maniP"
	PRIVENCRYPT "$Recipients" > "$tmp_manifest" <<EOF
$Refslist
$Packlist
$Keeplist
repo $Repoid
$Extnlist
EOF

	# Upload pack
	if [ -s "$tmp_objlist" ]
	then
		echo_info "Uploading encrypted pack"
		PUT "$URL" "$pack_id" "$tmp_encrypted"
	fi

	# Upload manifest
	echo_info "Uploading manifest"
	PUT "$URL" "$Manifestfile" "$tmp_manifest"

	# Clean up
	rm -f "$tmp_encrypted"
	rm -f "$tmp_objlist"
	rm -f "$tmp_manifest"

	# Return success status to Git
	if [ -n "$r_args" ]; then
		# Parse the refspec and return success
		while IFS=: read -r src_ dst_; do
			src_=${src_#+}
			echo_git "ok $dst_"
		done <<EOF
$r_args
EOF
	fi
	
	echo_git
}

