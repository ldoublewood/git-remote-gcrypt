# Enhanced: GPG wrapper function
rungpg()
{
	if isnonnull "$Conf_gpg_args"; then
		set -- "$Conf_gpg_args" "$@"
	fi
	# gpg will fail to run when there is no controlling tty,
	# due to trying to print messages to it, even if a gpg agent is set
	# up. --no-tty fixes this.
	if [ "x$GPG_AGENT_INFO" != "x" ]; then
		${GPG} --no-tty "$@"
	else
		${GPG} --no-tty --batch "$@"
	fi
}

# Enhanced: Encryption functions (real implementation)
ENCRYPT()
{
	local key="$1"
	rungpg --batch --force-mdc --compress-algo none --trust-model=always --passphrase-fd 3 -c 3<<EOF
$key
EOF
}

DECRYPT()
{
	local key="$1"
	rungpg -q --batch --no-default-keyring --secret-keyring /dev/null \
		--keyring /dev/null --passphrase-fd 3 -d 3<<EOF
$key
EOF
}

# Encrypt to recipients $1
PRIVENCRYPT()
{
	local recipients="$1"
	set -- $recipients
	if isnonnull "$Conf_signkey"; then
		set -- "$@" -u "$Conf_signkey"
	fi
	# For testing, use encrypt-only to avoid signing issues
	rungpg --compress-algo none --trust-model=always --armor -e "$@"
}

# $1 is the match for good signature, $2 is the textual signers list
PRIVDECRYPT()
{
	local sigmatch="$1"
	local signers="$2"
	local status_=
	exec 4>&1 &&
	status_=$(rungpg --status-fd 3 -q -d 3>&1 1>&4) &&
	xfeed "$status_" grep "^\[GNUPG:\] ENC_TO " >/dev/null &&
	(xfeed "$status_" grep -e "$sigmatch" >/dev/null || {
		echo_info "Failed to verify manifest signature!" &&
		echo_info "Only accepting signatories: ${signers:-(none)}" &&
		return 1
	})
}

# Generate $1 random bytes
genkey()
{
	local bytes="$1"
	rungpg --armor --gen-rand 1 "$bytes"
}

# Enhanced: GPG hash function (real implementation)
gpg_hash()
{
	local hash_type="$1"
	local hash_=
	hash_=$(rungpg --with-colons --print-md "$hash_type" | tr A-F a-f)
	hash_=${hash_#:*:}
	xecho "${hash_%:}"
}
# Enhanced: Interactive remote helper main loop
main_interactive()
{
	local remote_name="$1"
	local url="$2"
	local input_= input_inner= r_args=
	
	# Debug output
	if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
		echo_info "Remote name: $remote_name"
		echo_info "URL: $url"
	fi
	
	# Set global variables
	REMOTE_NAME="$remote_name"
	URL="$url"
	
	# Initialize temp directory
	Tempdir=$(mktemp -d)
	trap 'rm -rf "$Tempdir"' EXIT
	
	# Initialize local directory
	mkdir -p "$Localdir"
	
	# Setup incremental mode after we have all parameters
	setup_incremental_mode
	
	# Interactive command loop (like original git-remote-gcrypt)
	while read input_
	do
		if [ "${GCRYPT_DEBUG:-}" = "1" ]; then
			echo_info "Received command: $input_"
		fi
		
		case "$input_" in
		capabilities)
			echo "push"
			echo "fetch"
			echo ""
			;;
		list|list\ for-push)
			# Enhanced: Check for incremental mode during list
			if is_incremental_enabled; then
				echo_info "Incremental mode detected"
				get_latest_manifest_serial
			fi
			do_list
			;;
		fetch\ *)
			r_args=${input_##fetch }
			while read input_inner
			do
				case "$input_inner" in
				fetch*)
					r_args= #ignored
					;;
				*)
					break
					;;
				esac
			done
			# Enhanced: Try incremental pull first
			if is_incremental_enabled; then
				if do_incremental_pull "$r_args"; then
					echo_info "Incremental pull successful"
				else
					echo_info "Falling back to full fetch"
					do_fetch "$r_args"
				fi
			else
				do_fetch "$r_args"
			fi
			;;
		push\ *)
			r_args=${input_##push }
			while read input_inner
			do
				case "$input_inner" in
				push\ *)
					append_to @r_args "${input_inner#push }"
					;;
				*)
					break
					;;
				esac
			done
			# Enhanced: Try incremental push first
			if is_incremental_enabled; then
				if do_incremental_push "$r_args"; then
					echo_info "Incremental push successful"
				else
					echo_info "Falling back to full push"
					do_push "$r_args"
				fi
			else
				do_push "$r_args"
			fi
			;;
		?*)
			echo_die "Unknown input: $input_"
			;;
		*)
			# Empty line - cleanup and exit
			break
			;;
		esac
	done
}

