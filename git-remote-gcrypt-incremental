# Enhanced: Check if incremental mode is enabled for current branch
is_incremental_enabled()
{
	local current_branch= incremental_branch=
	current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
	incremental_branch=$(git config --get "remote.$REMOTE_NAME.gcrypt-incremental-branch" 2>/dev/null || echo "")
	
	if [ -n "$incremental_branch" ] && [ "$current_branch" = "$incremental_branch" ]; then
		Incremental_mode=yes
		Incremental_branch="$incremental_branch"
		echo_info "Incremental mode enabled for branch: $incremental_branch"
		return 0
	else
		Incremental_mode=no
		return 1
	fi
}

# Enhanced: Generate incremental file name
# $1: serial number (16 digits)
# $2: content to hash
generate_incremental_filename()
{
	local serial= content_hash=
	serial=$(printf "%016d" "$1")
	content_hash=$(echo -n "$2" | gpg_hash SHA256)
	echo "${serial}-${content_hash}"
}

# Enhanced: Parse incremental filename to get serial and hash
# $1: filename
# Returns: serial in $r_serial, hash in $r_hash
parse_incremental_filename()
{
	local filename= serial= hash=
	filename="$1"
	
	# Extract serial (first 16 digits)
	serial="${filename%%-*}"
	# Extract hash (after first dash)
	hash="${filename#*-}"
	
	setvar "@r_serial" "$serial"
	setvar "@r_hash" "$hash"
}

